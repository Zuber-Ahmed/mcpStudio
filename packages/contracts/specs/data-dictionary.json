  "constraints": [
    {
      "id": "DB01",
      "rule": "Each tenant-owned table exposes UNIQUE(tenant_id,id); parent references include tenant_id."
    },
    {
      "id": "DB02",
      "rule": "Graph edge from/to and candidate node must belong to same analysis and tenant."
    },
    {
      "id": "DB03",
      "rule": "Plan UNIQUE(tenant_id,analysis_run_id,version); partial unique current plan per analysis; monotonic version under lock."
    },
    {
      "id": "DB04",
      "rule": "Generation composite approval FK includes tenant_id,plan_id,approval_id; require current nonrevoked version/hash and current actor rights transactionally."
    },
    {
      "id": "DB05",
      "rule": "Plan recommendation and snapshot must belong to its analysis; candidate IDs must all belong to same tenant/analysis and match canonical payload."
    },
    {
      "id": "DB06",
      "rule": "Validation artifact_set_digest and policy must equal immutable generation/approved plan; semantic trigger/service admission plus transaction test."
    },
    {
      "id": "DB07",
      "rule": "Policy required_checks nonempty and unique; validation check unique(tenant_id,validation_run_id,name); executed and skipped field rules match OpenAPI."
    },
    {
      "id": "DB08",
      "rule": "Idempotency UNIQUE(tenant_id,actor_id,operation_id,key); digest conflict 409; outbox stable aggregate event identity prevents repeated effects."
    },
    {
      "id": "DB09",
      "rule": "No cascade deletion of audit/approval/validation; terminal runs require completed_at; hashes lowercase SHA256; relative safe artifact paths; no credentials."
    },
    {
      "id": "DB10",
      "rule": "Consent matches tenant/project/actor/source digest/provider/payload policy/expiry and is not revoked; never consent by unchecked JSON."
    }
  ],
  "physical_migrations_applied": false,
  "notes": "ERD is logical. Nullable parent references and conditional cross-field checks require physical design; see semantic-rules.md."
}
